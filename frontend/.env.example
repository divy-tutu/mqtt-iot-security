# Copy to .env.local and fill from the generated secrets/ (or run ../setup-hardened.sh,
# which writes .env.local for you). These power the SECURE dashboard build only;
# the insecure build needs none of them.
#
# NOTE: shipping keys to the browser is a testbed simplification, not a pattern
# to copy. The secure dashboard shows an on-screen notice to this effect.

VITE_MQTT_WSS_URL=wss://localhost:9002
VITE_MQTT_USERNAME=dashboard
VITE_MQTT_PASSWORD=dashboard-pass-2026

VITE_HMAC_SENSOR=<contents of secrets/sensor-livingroom.hmac.key>
VITE_HMAC_LOCK=<contents of secrets/lock-frontdoor.hmac.key>
VITE_HMAC_CAMERA=<contents of secrets/camera-frontdoor.hmac.key>
VITE_HMAC_OPERATOR=<contents of secrets/dashboard.hmac.key>
